    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.59.16",
    "axios": "^1.7.7",
    "pinia": "^2.3.0",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.31.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5",
    "vue-tsc": "^2.1.10"
  }
}
