# Local PostgreSQL/PostGIS
POSTGRES_DB=japan_discovery
POSTGRES_USER=japan_discovery
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_ENABLED=false
OSM_TIMEOUT_SECONDS=10
OSM_CACHE_SECONDS=300

# Frontend (Vite exposes only VITE_ variables to browser code)
VITE_API_BASE_URL=http://localhost:8080/api/v1
